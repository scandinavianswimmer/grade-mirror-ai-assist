{
  "name": "mr-selby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "cloudflare:dry-run": "npm run build && wrangler deploy --dry-run",
    "cloudflare:preview": "wrangler dev --local",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:ci && npm run build && npm run a11y:ci && npm run eval:dry && npm run eval:dry:dataset && npm run eval:calibrate",
    "a11y": "npm run build && npm run a11y:ci",
    "a11y:ci": "node qa-scripts/a11y.mjs",
    "eval:dry": "EVAL_DRY_RUN=1 node eval/run.mjs --judge",
    "eval:dry:dataset": "EVAL_DRY_RUN=1 node eval/run.mjs",
    "eval:calibrate": "node eval/calibration/false-finalize.mjs eval/calibration/holdout.sample.json --threshold 0.85 --tolerance 2",
    "eval:live": "node eval/run.mjs --judge"
  },
