# aiTA env var reference — copy what you need into your shell / `supabase secrets set`.
# NEVER commit a filled-in copy. Values here are placeholders only.

# ── Studio backend (DEFAULT) ─────────────────────────────────────────────────
# The default Gemini transport: generativelanguage.googleapis.com with a URL ?key= API key.
# This is all the eval harness and production need out of the box. Nothing below this block is
# required unless you explicitly opt into the Vertex backend.
GEMINI_API_KEY=your_key_here
# Optional comma-separated extra keys for free-tier quota rotation (production only).
GEMINI_API_KEYS=
# Optional: override the primary grading model (defaults baked into the engine).
GEMINI_GRADING_MODEL=

# ── Vertex AI backend (M1 — additive, OFF by default) ────────────────────────
# Leave ALL of these unset to keep the default studio path byte-for-byte unchanged.
# Turn Vertex ON with EITHER GEMINI_BACKEND=vertex OR VERTEX_AI=true. Vertex is only actually
# used when it's requested AND every prerequisite below is present; otherwise the client silently
# stays on the studio path, so flipping the flag early never breaks grading.
GEMINI_BACKEND=studio        # studio (default) | vertex
VERTEX_AI=                   # alternative toggle: true|1|yes|on
VERTEX_PROJECT=              # your GCP project id (required for Vertex)
VERTEX_LOCATION=us-central1  # GCP region; also the endpoint subdomain (required for Vertex)
# Auth: provide ONE of the following (see _shared/ai/google-auth.ts).
#   (a) A pre-minted OAuth2 access token (operator manages refresh; e.g. gcloud print-access-token):
GOOGLE_OAUTH_TOKEN=
#   (b) A full service-account key JSON (the client mints + caches a 1h token via RS256 JWT):
GOOGLE_SERVICE_ACCOUNT_JSON=
