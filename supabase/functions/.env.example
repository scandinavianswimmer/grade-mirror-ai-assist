# Edge Function (server-side) secrets — REFERENCE ONLY. These are SERVER secrets and must NEVER be
# committed or placed in the client .env. Set them on the deployed project with:
#   supabase secrets set NAME=value
# and list current ones with:  supabase secrets list
#
# This file documents every secret the functions read (grep: Deno.env.get / _shared/env.ts) so the
# required surface is auditable in one place. Values are intentionally blank.

# ── Supabase platform (auto-injected into deployed functions; set only for local serve) ──────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini grading (Google Generative Language API) ──────────────────────────────────────────────
# Primary key (REQUIRED). All grading + style/podcast generation use this by default.
GEMINI_API_KEY=
# OPTIONAL rotation pool: comma-separated extra keys. call() rotates to the next on 429/quota.
# Stopgap for free-tier limits; replace with one billed key when available. See _shared/ai/gemini.ts.
GEMINI_API_KEYS=
# OPTIONAL cross-tenant ceiling: max upstream Gemini calls/min across all tenants (default 120).
# Only enforced when Upstash is configured (Layer B). See _shared/ratelimit.ts.
GEMINI_GLOBAL_QPM=
# OPTIONAL dev-mode pacer: minimum ms between upstream Gemini calls (default 0 = off in prod).
# Set e.g. 4000 in dev (~15/min) so free-tier RPM isn't exceeded — DELAYS, never rejects.
GEMINI_MIN_CALL_INTERVAL_MS=
# OPTIONAL model overrides (default gemini-2.5-pro primary → gemini-2.5-flash fallback).
GEMINI_GRADING_MODEL=
GEMINI_STYLE_MODEL=

# ── Async grading queue + Layer B ceiling (Upstash Redis REST) ───────────────────────────────────
# Required for "Grade all ungraded" (grade-enqueue) and for the global rate ceiling to be enforced.
# When unset, bulk grading returns queue_unconfigured and Layer B fails open (no global ceiling).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Service-to-service / cron auth ───────────────────────────────────────────────────────────────
# Shared secret the Cloud Run grading worker presents (x-internal-secret) to grade-submission.
# Generate: openssl rand -hex 32. If unset, the internal worker path is disabled (JWT path only).
INTERNAL_GRADE_SECRET=
# Gates the cron-only privacy-tasks function (x-cron-secret). Generate: openssl rand -hex 32.
CRON_SECRET=

# ── CORS + app ───────────────────────────────────────────────────────────────────────────────────
# Comma-separated browser origin allowlist (no wildcard). Include the deployed frontend origin.
ALLOWED_ORIGINS=
# Where Stripe sends the teacher back after Checkout / the Customer Portal (no trailing slash).
APP_URL=

# ── Secondary AI feedback path (generate-grading-feedback) ───────────────────────────────────────
LOVABLE_API_KEY=

# ── Billing (Stripe) ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-plan Stripe Price IDs, one per plan: STRIPE_PRICE_<PLAN>  (e.g. STRIPE_PRICE_PRO).
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
