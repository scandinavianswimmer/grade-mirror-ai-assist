# Client (Vite) — these are PUBLIC (anon) values, safe to expose in the browser.
# Copy to .env and fill in. The real .env is gitignored; never commit it.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Product analytics (Phase 11 / METRIC-04). OPTIONAL — leave blank to disable.
# When VITE_POSTHOG_KEY is unset, analytics no-ops gracefully (no events sent, no errors).
# The key is a PUBLIC PostHog project API key, safe to expose in the browser.
VITE_POSTHOG_KEY=
# Optional: override the PostHog ingestion host (defaults to PostHog Cloud US).
VITE_POSTHOG_HOST=

# Server secrets do NOT belong here. Set them as Supabase function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=... CRON_SECRET=... ALLOWED_ORIGINS=...
