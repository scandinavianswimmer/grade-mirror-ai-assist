# Client (Vite) — these are PUBLIC (anon) values, safe to expose in the browser.
# Copy to .env and fill in. The real .env is gitignored; never commit it.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Product analytics (Phase 11 / METRIC-04). OPTIONAL — leave blank to disable.
# When VITE_POSTHOG_KEY is unset, analytics no-ops gracefully (no events sent, no errors).
# The key is a PUBLIC PostHog project API key, safe to expose in the browser.
VITE_POSTHOG_KEY=
# Optional: override the PostHog ingestion host (defaults to PostHog Cloud US).
VITE_POSTHOG_HOST=

# Public, monitored inbox for School / Dept pricing enquiries. When blank, the CTA is disabled.
VITE_SCHOOL_CONTACT_EMAIL=

# Firebase (web app config). PUBLIC identifiers — safe to expose in the browser and commit.
# Security is enforced by Firebase Security Rules / App Check, NOT by key secrecy.
# Project: aita-5aca5. Used for Firebase Hosting; Analytics/Auth wiring is a later migration step.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aita-5aca5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aita-5aca5
VITE_FIREBASE_STORAGE_BUCKET=aita-5aca5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=45690128682
VITE_FIREBASE_APP_ID=1:45690128682:web:31d6155a1938658efeb653
VITE_FIREBASE_MEASUREMENT_ID=G-KQK6HSQV47

# Server secrets do NOT belong here. Set them as Supabase function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=... CRON_SECRET=... ALLOWED_ORIGINS=...
