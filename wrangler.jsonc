{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mr-selby",
  "main": "./worker/cloudflare.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "mrselby.app",
      "custom_domain": true
    },
    {
      "pattern": "www.mrselby.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
