# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Firebase (hosting) — build cache + debug logs, not source.
.firebase/
firebase-debug.log
firebase-debug.*.log

# Secrets — never commit. Run `git rm --cached .env` to untrack the existing one.
.env
.env.*
!.env.example
supabase/.env
supabase/.env.*

# Keys, certs, and service-account credentials — never commit.
*.key
*.pem
*service-account*.json
*-sa.json
gcp-*.json

# Database backups / dumps — never commit.
*.sql.backup
*.backup

# Supabase CLI cache (project ref, pooler url, linked-project) — not source.
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# QA/audit run artifacts — regenerable Playwright output (screenshots, audit json)
qa-artifacts/

# Relocated Desktop reference assets (32M of screenshots, sample essays, Sleuth runs) — not source
docs/loose-assets-2026-06/
